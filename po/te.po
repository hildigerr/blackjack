msgstr "నిండుతెరను వదులుము (_L)"

msgid "Network _Game"
msgstr "అల్లికలో ఆట (_G)"

msgid "L_eave Game"
msgstr "ఆటను వదులుము (_e)"

msgid "Player _List"
msgstr "ఆటగాళ్ళ జాబితా (_L)"

msgid "_Pause"
msgstr "నిలుపువేయు (_P)"

msgid "Res_ume"
msgstr "తిరిగి కొనసాగించుము (_u)"

msgid "_Scores"
msgstr "స్కోర్లు (_S)"

msgid "_End Game"
msgstr "ఆటను పూర్తిచేయు (_E)"

